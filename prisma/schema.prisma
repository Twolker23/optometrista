generator client {
    provider = "prisma-client-js"
    binaryTargets = ["native", "linux-musl-arm64-openssl-3.0.x"]
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

enum UserGroup {
  ADMIN
  LOJA
  SAC
  OPTO
}

enum QueueStatus {
  AGENDADO        // Fila de Clientes Agendados
  RETORNO_LOJA    // Fila de Retorno à Loja
  NAO_APTO        // Fila dos Não Aptos
  VENDA           // Fila de Vendas
  REPESCAGEM      // Fila Repescagem
  RENEGOCIACAO    // Fila de Renegociação
}

enum RenegotiationReason {
  NAO_COMPARECEU  // Cliente não compareceu ao exame
  NAO_COMPROU     // Cliente compareceu mas não comprou
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Unidade {
  id        String   @id @default(cuid())
  nome      String   @unique
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  users     User[]
  clients   Client[]
}

model User {
  id                String         @id @default(cuid())
  name              String?
  email             String?        @unique
  emailVerified     DateTime?
  image             String?
  password          String?
  userGroup         UserGroup      @default(LOJA)
  isActive          Boolean        @default(true)
  unidadeId         String?        // Opcional para ADMIN (global), obrigatório para outros
  unidade           Unidade?       @relation(fields: [unidadeId], references: [id])
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  accounts          Account[]
  sessions          Session[]
  clientsCreated    Client[]       @relation("ClientCreator")
  queueHistories    QueueHistory[]
  appointmentsAsOptometrist Appointment[] @relation("OptometristAppointments")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Client {
  id                   String               @id @default(cuid())
  name                 String
  birthDate            DateTime
  phone                String
  createdById          String
  createdBy            User                 @relation("ClientCreator", fields: [createdById], references: [id])
  createdByGroup       UserGroup
  currentStatus        QueueStatus          @default(AGENDADO)
  renegotiationReason  RenegotiationReason? // Motivo da entrada em RENEGOCIACAO
  recovered            Boolean              @default(false) // Cliente recuperado da Repescagem
  unidadeId            String?              // Unidade do atendimento (temporariamente opcional para migração)
  unidade              Unidade?             @relation(fields: [unidadeId], references: [id])
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  appointments         Appointment[]
  queueHistories       QueueHistory[]
}

model Appointment {
  id               String         @id @default(cuid())
  clientId         String
  client           Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  optometristId    String
  optometrist      User           @relation("OptometristAppointments", fields: [optometristId], references: [id])
  scheduledDate    DateTime
  scheduledTime    String
  attended         Boolean?
  attendedAt       DateTime?
  isApt            Boolean?
  aptJustification String?        @db.Text
  photoId          String?        @unique
  photo            Photo?         @relation(fields: [photoId], references: [id])
  saleId           String?        @unique
  sale             Sale?          @relation(fields: [saleId], references: [id])
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  queueHistories   QueueHistory[]
}

model Photo {
  id                String       @id @default(cuid())
  cloudStoragePath  String
  url               String?      // ✅ URL pública/privada do arquivo (opcional)
  isPublic          Boolean      @default(false)
  uploadDate        DateTime     @default(now())
  appointment       Appointment?
}

model Sale {
  id           String       @id @default(cuid())
  os           String
  value        Decimal      @db.Decimal(10, 2)
  justification String?     @db.Text
  createdAt    DateTime     @default(now())
  appointment  Appointment?
}

model QueueHistory {
  id            String      @id @default(cuid())
  clientId      String
  client        Client      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  appointmentId String?
  appointment   Appointment? @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  fromStatus    QueueStatus?
  toStatus      QueueStatus
  userId        String
  user          User        @relation(fields: [userId], references: [id])
  action        String
  justification String?     @db.Text
  createdAt     DateTime    @default(now())
}
