generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserGroup {
  ADMIN
  LOJA
  SAC
  OPTO
}

enum QueueStatus {
  AGENDADO
  RETORNO_LOJA
  NAO_APTO
  VENDA
  REPESCAGEM
  RENEGOCIACAO
}

enum RenegotiationReason {
  NAO_COMPARECEU
  NAO_COMPROU
}

model Unidade {
  id        String   @id @default(cuid())
  nome      String   @unique
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users   User[]
  clients Client[]
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?
  userGroup     UserGroup @default(LOJA)
  isActive      Boolean   @default(true)

  unidadeId String?
  unidade   Unidade? @relation(fields: [unidadeId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts       Account[]
  sessions       Session[]
  clientsCreated Client[]       @relation("ClientCreator")
  appointments   Appointment[]  @relation("OptometristAppointments")
  queueHistories QueueHistory[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Client {
  id                  String               @id @default(cuid())
  name                String
  birthDate           DateTime
  phone               String
  createdById         String
  createdBy           User                 @relation("ClientCreator", fields: [createdById], references: [id])
  createdByGroup      UserGroup
  currentStatus       QueueStatus          @default(AGENDADO)
  renegotiationReason RenegotiationReason?
  recovered           Boolean              @default(false)

  unidadeId String?
  unidade   Unidade? @relation(fields: [unidadeId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  appointments   Appointment[]
  queueHistories QueueHistory[]
}

model Appointment {
  id               String    @id @default(cuid())
  clientId         String
  optometristId    String
  scheduledDate    DateTime
  scheduledTime    String
  attended         Boolean?
  attendedAt       DateTime?
  isApt            Boolean?
  aptJustification String?   @db.Text

  client      Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  optometrist User   @relation("OptometristAppointments", fields: [optometristId], references: [id])

  photoId String? @unique
  photo   Photo?  @relation(fields: [photoId], references: [id])

  saleId String? @unique
  sale   Sale?   @relation(fields: [saleId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  queueHistories QueueHistory[]
}

model Photo {
  id               String   @id @default(cuid())
  cloudStoragePath String
  url              String?
  isPublic         Boolean  @default(false)
  uploadDate       DateTime @default(now())

  appointment Appointment?
}

model Sale {
  id            String   @id @default(cuid())
  os            String
  value         Decimal  @db.Decimal(10, 2)
  justification String?  @db.Text
  createdAt     DateTime @default(now())

  appointment Appointment?
}

model QueueHistory {
  id            String       @id @default(cuid())
  clientId      String
  appointmentId String?
  fromStatus    QueueStatus?
  toStatus      QueueStatus
  userId        String
  action        String
  justification String?      @db.Text
  createdAt     DateTime     @default(now())

  client      Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  appointment Appointment? @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  user        User         @relation(fields: [userId], references: [id])
}
